# Variabel Docker Compose untuk Server Sekolah (Salin menjadi docker/.env)
# Gunakan password >= 16 karakter; jika berisi @ : / # ? &, lakukan URL-encode untuk DATABASE_URL.
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT
MYSQL_DATABASE=lms_smkn1
MYSQL_USER=lms_user
MYSQL_PASSWORD=GANTI_PASSWORD_APP_KUAT
AUTO_SEED=true
TZ=Asia/Jakarta

# Bind mount host eksplisit (bukan named volume Docker)
STORAGE_HOST_PATH=/var/lib/lms-smkn1/storage
MYSQL_HOST_PATH=/var/lib/lms-smkn1/mysql-data
BACKUP_HOST_PATH=/var/lib/lms-smkn1/backups
